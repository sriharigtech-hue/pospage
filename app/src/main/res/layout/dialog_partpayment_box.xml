<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clickLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/transparent"
    tools:ignore="TooManyViews,HardcodedText,RtlHardcoded,SpUsage">

    <!-- Top Close (X) Icon -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/cancel"
        android:layout_width="@dimen/_30dp"
        android:layout_height="@dimen/_30dp"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="@dimen/_2dp"
        android:elevation="8dp"
        android:padding="@dimen/_2dp"
        android:src="@drawable/cancel" />

    <!-- Card container -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_4dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/_12dp"
        app:cardElevation="2dp"
        app:cardPreventCornerOverlap="true"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical">

            <!-- Content section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8dp"
                android:orientation="vertical">



                <!-- Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/hint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="42dp"
                    android:layout_marginTop="@dimen/_12dp"
                    android:hint="Billing Amount *"
                    android:textColorHint="@color/black"
                    app:boxBackgroundColor="@color/white"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="@dimen/_24dp"
                    app:boxCornerRadiusBottomStart="@dimen/_24dp"
                    app:boxCornerRadiusTopEnd="@dimen/_24dp"
                    app:boxCornerRadiusTopStart="@dimen/_24dp"
                    app:boxStrokeColor="@color/colorPrimary"
                    app:boxStrokeErrorColor="@color/red_EB5757"
                    app:boxStrokeWidth="@dimen/_1dp"
                    app:boxStrokeWidthFocused="@dimen/_2dp"
                    app:cursorColor="@color/colorPrimary"
                    app:hintAnimationEnabled="true"
                    app:hintTextAppearance="@style/MyCustomTextAppearance1"
                    app:hintTextColor="@color/black">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/font_semibold"
                        android:gravity="center_vertical"
                        android:inputType="number"
                        android:paddingVertical="@dimen/_16dp"
                        android:paddingStart="@dimen/_16dp"
                        android:paddingEnd="@dimen/_16dp"
                        android:textColor="@color/black"
                        android:textColorHint="@color/_9ea1a9"
                        android:textSize="@dimen/_16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Buttons Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="42dp"
                    android:layout_marginTop="@dimen/_18dp"
                    android:layout_marginBottom="@dimen/_18dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <!-- ✅ OK Button (Left) -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/okBtn"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_46dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/_8dp"
                        android:background="@drawable/gradient_btn"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/font_semibold"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:gravity="center"
                        android:text="OK"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_16sp" />

                    <!-- ❌ Cancel Button (Right) -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/cancelBtn"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_46dp"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/_8dp"
                        android:background="@drawable/outer_curve_border"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/font_semibold"
                        android:gravity="center"
                        android:text="Cancel"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/_16sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
