<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clickLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/transparent"
    tools:ignore="TooManyViews,HardcodedText,RtlHardcoded,SpUsage">


    <androidx.appcompat.widget.AppCompatImageView
        android:id="@id/cancel"
        android:layout_width="@dimen/_30dp"
        android:layout_height="@dimen/_30dp"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="@dimen/_2dp"
        android:elevation="8dp"
        android:padding="@dimen/_2dp"
        android:src="@drawable/cancel" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_4dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/_12dp"
        app:cardElevation="2dp"
        app:cardPreventCornerOverlap="true"
        app:cardUseCompatPadding="true">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/flat"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_46dp"
                    android:layout_weight="1"
                    android:background="@drawable/gradient_bg"
                    android:fontFamily="@font/font_semibold"
                    android:gravity="center"
                    android:text="Flat"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_12sp" />


                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/percentage"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_46dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/font_semibold"
                    android:gravity="center"
                    android:text="Percentage"
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/_12sp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@drawable/gradient_bg">

            </View>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8dp"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/hint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_16dp"
                    android:layout_marginTop="@dimen/_12dp"
                    android:hint="Enter Flat Discount Amount *"
                    android:textColorHint="@color/black"
                    app:boxBackgroundColor="@color/white"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="@dimen/_24dp"
                    app:boxCornerRadiusBottomStart="@dimen/_24dp"
                    app:boxCornerRadiusTopEnd="@dimen/_24dp"
                    app:boxCornerRadiusTopStart="@dimen/_24dp"
                    app:boxStrokeColor="@color/colorPrimary"
                    app:boxStrokeErrorColor="@color/red_EB5757"
                    app:boxStrokeWidth="@dimen/_1dp"
                    app:boxStrokeWidthFocused="@dimen/_2dp"
                    app:cursorColor="@color/colorPrimary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/discountValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/font_medium"
                        android:gravity="center_vertical"
                        android:inputType="numberDecimal"
                        android:paddingVertical="@dimen/_16dp"
                        android:paddingStart="@dimen/_16dp"
                        android:paddingEnd="@dimen/_16dp"
                        android:textColor="@color/black"
                        android:textColorHint="@color/_9ea1a9"
                        android:textSize="@dimen/_13sp" />
                </com.google.android.material.textfield.TextInputLayout>


                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/enter"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_46dp"
                    android:layout_marginHorizontal="@dimen/_16dp"
                    android:layout_marginVertical="@dimen/_18dp"
                    android:background="@drawable/gradient_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/font_bold"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="ENTER"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_14sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>



