<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgColor"
   >

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bgColor"
        android:orientation="vertical"
        android:visibility="visible">

        <RelativeLayout
            android:id="@+id/overallServiceListLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/toolbar_layout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_64dp"
                android:background="@drawable/gradient_bg"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <RelativeLayout
                        android:id="@+id/backButton"
                        android:layout_width="@dimen/_32dp"
                        android:layout_height="@dimen/_32dp"
                        android:layout_marginStart="@dimen/_18dp"
                        android:background="@drawable/button_curve_border"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/_18dp"
                            android:layout_height="@dimen/_18dp"
                            android:layout_centerInParent="true"
                            app:srcCompat="@drawable/back" />
                    </RelativeLayout>
                </LinearLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/_8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/_8dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <pl.droidsonroids.gif.GifImageView
                            android:id="@+id/splashLogo2"
                            android:layout_width="@dimen/_110dp"
                            android:layout_height="@dimen/_24dp"
                            android:layout_gravity="start"
                            android:src="@drawable/splash2" />
                    </LinearLayout>
                </RelativeLayout>
            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/toolbar_layout"
                android:background="@color/bgColor">


                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_above="@+id/planUpdateButton"
                    android:layout_marginHorizontal="@dimen/_12dp"
                    android:layout_marginTop="@dimen/_12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/shopLanguageLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="@dimen/_12dp"
                                android:layout_marginTop="@dimen/_16dp"
                                android:fontFamily="@font/font_bold"
                                android:gravity="center"
                                android:text="Unlock the GINEX premium experience"
                                android:textColor="@color/textBlack"
                                android:textSize="@dimen/_16sp" />

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="@dimen/_12dp"
                                android:layout_marginTop="@dimen/_12dp"
                                android:background="@color/bgColor"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?android:attr/selectableItemBackground"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingVertical="@dimen/_4dp">

                                <LinearLayout
                                    android:id="@+id/language_layout"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:background="@drawable/gradient_btn_2"
                                    android:backgroundTint="@color/bed7d6d6"
                                    android:orientation="horizontal">

                                    <RelativeLayout
                                        android:id="@+id/english"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_margin="@dimen/_8dp"
                                        android:layout_weight="1"
                                        android:background="@drawable/gradient_btn"
                                        android:elevation="4dp"
                                        android:paddingHorizontal="@dimen/_12dp"
                                        android:paddingVertical="@dimen/_12dp">

                                        <com.google.android.material.imageview.ShapeableImageView
                                            android:id="@+id/icon01"
                                            android:layout_width="@dimen/_20dp"
                                            android:layout_height="@dimen/_20dp"
                                            android:layout_marginStart="@dimen/_4dp"
                                            android:layout_marginEnd="@dimen/_8dp"
                                            android:visibility="gone" />


                                        <androidx.appcompat.widget.AppCompatTextView
                                            android:id="@+id/english1"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_toEndOf="@+id/icon01"
                                            android:fontFamily="@font/font_bold"
                                            android:gravity="center"
                                            android:text="1 Year"
                                            android:textColor="@color/white"
                                            android:textSize="@dimen/_16sp" />

                                    </RelativeLayout>

                                    <RelativeLayout
                                        android:id="@+id/others"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_margin="@dimen/_8dp"
                                        android:layout_weight="1"
                                        android:elevation="4dp"
                                        android:paddingHorizontal="@dimen/_12dp"
                                        android:paddingVertical="@dimen/_12dp">

                                        <com.google.android.material.imageview.ShapeableImageView
                                            android:id="@+id/icon11"
                                            android:layout_width="@dimen/_20dp"
                                            android:layout_height="@dimen/_20dp"
                                            android:layout_marginStart="@dimen/_4dp"
                                            android:layout_marginEnd="@dimen/_8dp"
                                            android:visibility="gone" />


                                        <androidx.appcompat.widget.AppCompatTextView
                                            android:id="@+id/others1"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_toEndOf="@+id/icon11"
                                            android:fontFamily="@font/font_bold"
                                            android:gravity="center"
                                            android:text="6 Months"
                                            android:textColor="@color/textBlack"
                                            android:textSize="@dimen/_16sp" />

                                    </RelativeLayout>

                                </LinearLayout>

                            </RelativeLayout>
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/list_radio"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/bgColor"

                            android:nestedScrollingEnabled="false"
                            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/_8dp"
                            android:layout_marginVertical="@dimen/_16dp"
                            android:background="@drawable/gradient_btn_2"
                            android:backgroundTint="@color/beede8e8"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingHorizontal="@dimen/_8dp"
                                android:paddingVertical="@dimen/_8dp">

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:fontFamily="@font/font_bold"
                                    android:gravity="center_vertical"
                                    android:text="GINEX Available Features"
                                    android:textColor="@color/textBlack"
                                    android:textSize="@dimen/_20sp" />
                            </LinearLayout>

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/posfeaturelist"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginBottom="@dimen/_16dp"

                                android:nestedScrollingEnabled="false"
                                app:layout_behavior="@string/appbar_scrolling_view_behavior" />

                        </LinearLayout>

                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/planUpdateButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_marginHorizontal="@dimen/_24dp"
                    android:layout_marginTop="@dimen/_12dp"
                    android:layout_marginBottom="@dimen/_12dp"
                    android:background="@drawable/gradient_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/font_semibold"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center"
                    android:paddingVertical="@dimen/_16dp"
                    android:text="Plan Update"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_16sp" />

                <RelativeLayout
                    android:id="@+id/no_item_status"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/bgColor"
                    android:gravity="center"
                    android:visibility="gone">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/no_cart"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_alignParentTop="true"
                        android:layout_centerHorizontal="true"
                        android:layout_centerVertical="true"
                        android:layout_marginTop="@dimen/_18dp"
                        app:srcCompat="@drawable/search"
                        app:tint="@color/colorPrimary" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/no"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/no_cart"
                        android:layout_centerHorizontal="true"
                        android:layout_centerVertical="true"
                        android:layout_marginVertical="@dimen/_20dp"
                        android:fontFamily="@font/font_semibold"
                        android:gravity="center"
                        android:text="No Plans found"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/_14sp"
                        android:textStyle="bold"
                        tools:ignore="RtlHardcoded" />
                </RelativeLayout>
            </RelativeLayout>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>