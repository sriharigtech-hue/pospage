<?xml version="1.0" encoding="utf-8"?>
<LinearLayout  xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/transparent"
    tools:ignore="SpUsage,HardcodedText">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/tipLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bottom_dialog_background"
        android:backgroundTint="@color/white"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_24dp"
            android:layout_marginBottom="@dimen/_8dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/guideTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/_6dp"
                    android:layout_marginStart="@dimen/_16dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/font_bold"
                    android:text="For Customized Report, Please contact us using any one of the below options"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_15sp" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/closeDialog"
                    android:layout_width="@dimen/_30dp"
                    android:layout_height="@dimen/_30dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/_16dp"
                    android:src="@drawable/cancel" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="@dimen/_16dp"
                android:layout_marginVertical="4dp"
                android:background="@color/grayA6AEBB" />


            <LinearLayout
                android:id="@+id/callSupport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:paddingVertical="@dimen/_8dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/_32dp"
                    android:layout_height="@dimen/_32dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/call" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_16dp"
                        android:fontFamily="@font/font_bold"
                        android:text="9987654356"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_13sp" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/numbercontent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="@dimen/_4dp"
                        android:layout_marginStart="@dimen/_16dp"
                        android:fontFamily="@font/font_medium"
                        android:gravity="center_vertical"
                        android:text=""
                        android:textColor="@color/_797979"
                        android:textSize="@dimen/_11sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="@dimen/_16dp"
                android:layout_marginVertical="4dp"
                android:background="@color/grayA6AEBB" />

            <LinearLayout
                android:id="@+id/whatsAppSupport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:paddingVertical="@dimen/_8dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/_32dp"
                    android:layout_height="@dimen/_32dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/whatsapp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_16dp"
                        android:fontFamily="@font/font_bold"
                        android:text="Whatsapp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_13sp" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="@dimen/_4dp"
                        android:layout_marginStart="@dimen/_16dp"
                        android:fontFamily="@font/font_medium"
                        android:gravity="center_vertical"
                        android:text="Direct Message"
                        android:textColor="@color/_797979"
                        android:textSize="@dimen/_11sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:id="@+id/whatsAppSupportLine"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="@dimen/_16dp"
                android:layout_marginVertical="4dp"
                android:background="@color/grayA6AEBB" />

            <LinearLayout
                android:id="@+id/emailSupport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_16dp"
                android:layout_marginBottom="@dimen/_16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:paddingVertical="@dimen/_8dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/_32dp"
                    android:layout_height="@dimen/_32dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/mail" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_16dp"
                        android:fontFamily="@font/font_bold"
                        android:text="Email Us"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_13sp" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/emailAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="@dimen/_4dp"
                        android:layout_marginStart="@dimen/_16dp"
                        android:fontFamily="@font/font_medium"
                        android:gravity="center_vertical"
                        android:textColor="@color/_797979"
                        android:textSize="@dimen/_11sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>
</LinearLayout >